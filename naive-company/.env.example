# Copy to .env (git-ignored) and fill in. Read by pnpm serve, pnpm naive …, pnpm naive:plan/up, pnpm live:run.
# Get a key at https://app.usenaive.ai (API keys) — it is shown once.
NAIVE_API_KEY=

# Third-party MCP servers the crew uses. `naive up` seals these into the agency identity's vault
# (write-once); agents never see them. AgentMail: https://console.agentmail.to → Settings → API Keys.
# Monid: https://app.monid.ai/access/api-keys
AGENTMAIL_API_KEY=
MONID_API_KEY=
# autoops-voice MCP (Swayam's receptionist service): ask Swayam for the bearer token.
AUTOOPS_VOICE_TOKEN=
